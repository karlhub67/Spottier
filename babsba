.chips{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.chip{border:1px solid var(--border);background:var(--card);border-radius:999px;padding:6px 12px}
.note{background:var(--card);border:1px dashed var(--accent);border-radius:14px;padding:14px;color:var(--muted);margin:14px 0}
.empty{text-align:center;padding:50px 16px;color:var(--muted)}.empty .cov{width:96px;margin:0 auto 14px}
