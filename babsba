.sbar{justify-self:center;width:100%;max-width:520px;border-width:1.5px;transition:max-width .3s cubic-bezier(.3,.8,.3,1),border-color .2s,box-shadow .25s}
.sbar:focus-within{max-width:640px;border-color:var(--navOn);box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 28%,transparent),0 6px 18px color-mix(in srgb,var(--accent) 25%,transparent)}
