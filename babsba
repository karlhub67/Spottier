.cp{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px 18px}.cp div{display:flex;gap:8px;align-items:center}.cp label{flex:1;font-size:.9em}.cp input[type=color]{width:38px;height:32px;padding:0;border:1px solid var(--border);border-radius:8px;background:none}.cp input[type=text]{width:92px;border:1px solid var(--border);border-radius:8px;background:var(--search);color:var(--text);padding:6px;font:inherit}
